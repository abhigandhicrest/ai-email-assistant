APP_ENV=local
# 127.0.0.1 keeps the API on this computer. Use 0.0.0.0 only when another machine must connect.
APP_HOST=127.0.0.1
APP_PORT=8000
# Replace this placeholder with a unique value of at least 16 characters.
API_KEY=replace-with-a-long-random-string
DATABASE_URL=mysql+pymysql://root:replace-with-password@127.0.0.1:3306/ai_email_assistant
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
